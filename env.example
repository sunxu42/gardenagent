# =============================================================================
# GardenAI 环境变量模板（密钥 / 凭证）
# 用法：复制为 .env 并填入真实值
# 运行时参数（模型名、URL、开关、阈值等）请写在 .config.yaml
# 加载入口：load_secrets()（yard/configs/secrets.py）
# =============================================================================

# ==================== LLM（阿里百炼 / DashScope）====================

# 统一平台 API Key（必填）
# 用于：主对话、情绪判定、Mem0 抽取/Embedding、DeepEval 评测等所有 LLM 调用
# 各场景使用的模型名与 API 根 URL 请在 .config.yaml 中分别配置
DASHSCOPE_API_KEY=

# ASR（百炼 DashScope）复用上方 DASHSCOPE_API_KEY，模型名在 .config.yaml 的 audio_config.asr_model

# TTS（百炼 DashScope）复用上方 DASHSCOPE_API_KEY；模型/音色/WebSocket 地址在 .config.yaml 的 tts_config

# ==================== Langfuse 观测（可选）====================
# 两项都填才启用 LLM 调用链追踪；任一项为空则完全跳过
# 无需在 .config.yaml 配置；默认连接本地 http://localhost:3000
# 高级覆盖（一般不用改）：LANGFUSE_BASE_URL、LANGFUSE_TIMEOUT、
# LANGFUSE_PROBE_TIMEOUT_SEC、LANGFUSE_PROBE_REACHABILITY
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# macOS + Anaconda：mem0 NLP（spacy）可能与 faiss/numpy 重复加载 OpenMP，导致进程 abort
# 服务端入口 server/__main__.py 已默认 setdefault；也可在此显式设置
# KMP_DUPLICATE_LIB_OK=TRUE

# ==================== 运行时覆盖（可选，一般不用改）====================

# Mem0 操作历史 SQLite 路径（覆盖 Mem0 默认 ~/.mem0/history.db）
# MEM0_HISTORY_DB_PATH=~/.mem0/history.db

# 日志目录覆盖（默认：项目根目录 logs/）
# GARDEN_LOG_DIR=

# 跨进程共享状态后端类型（默认 lmdb；亦支持 redis 等，视实现而定）
# SHARED_STATE_BACKEND=lmdb
