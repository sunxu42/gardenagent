# 统一环境变量配置文件
# 复制此文件为 .env 并填入实际配置值

# ==================== LLM 配置 ====================
GLM_OPENAI_API_KEY=
GLM_OPENAI_BASE_URL=
# 主对话模型在 .config.yaml 的 llm_model_name；前置 VAD 判定见 emotion_appraisal_model（默认 glm-4.7-flash，共用本 Key）

# ==================== ASR 配置 ====================
DOUBAO_STREAMING_ASR_APPID=
DOUBAO_STREAMING_ASR_ACCESS_TOKEN=
# aliyun 长期使用配置
# ALIYUN_ACCESS_KEY_ID=your_access_key_id 
# ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
# aliyun 短期使用配置
ALIYUN_APPKEY=
ALIYUN_TOKEN=

# ==================== TTS 配置 ====================
HUOSHAN_APPID=
HUOSHAN_ACCESS_TOKEN=
# ALIYUN_TTS_ACCESS_KEY_ID=your_access_key_id 
# ALIYUN_TTS_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_TTS_APPKEY=
ALIYUN_TTS_TOKEN=

# ==================== Mem0 配置 ====================
# 在 .config.yaml 中设置 memory_enabled: true 后生效
# MEM0_EMBEDDING_MODEL=embedding-3
# MEM0_EMBEDDING_DIMS=1536
# MEM0_HISTORY_DB_PATH=~/.mem0/history.db