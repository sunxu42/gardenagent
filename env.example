# 统一环境变量配置文件
# 复制此文件为 .env 并填入实际配置值

# ==================== 通用配置 ====================
# 音频通用配置（用于WebSocket）
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BITS_PER_SAMPLE=16

# 日志通用配置
LOG_LEVEL=INFO

# ==================== WebSocket 配置 ====================
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8005
# WebSocket 日志文件（通过 LOG_FILE 环境变量配置）
LOG_FILE=logs/websocket_server.log

# ==================== ZeroMQ 配置 ====================
# ASR 服务地址
ASR_LISTEN_ADDRESS=ipc:///tmp/asr_listen
ASR_PUBLISH_ADDRESS=ipc:///tmp/asr_publish

# TTS 服务地址
TTS_LISTEN_ADDRESS=ipc:///tmp/tts_listen
TTS_PUBLISH_ADDRESS=ipc:///tmp/tts_publish

# ==================== ASR 配置 ====================
# ASR 提供商
ASR_PROVIDER=


DOUBAO_STREAMING_ASR_APPID=
DOUBAO_STREAMING_ASR_ACCESS_TOKEN=
# 在环境变量或配置中设置
ASR_PROVIDER=AliyunStreamingASR
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_APPKEY=your_appkey
# ==================== TTS 配置 ====================
# TTS 提供商
TTS_PROVIDER=huoshan

# TTS 服务日志文件
TTS_SERVICE_LOG=logs/tts_service.log

# 火山引擎TTS配置（仅保留必需参数）
HUOSHAN_APPID=
HUOSHAN_ACCESS_TOKEN=
HUOSHAN_RESOURCE_ID=
HUOSHAN_WS_URL=
