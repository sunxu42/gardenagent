# =============================================================================
# GardenAI 环境变量模板（密钥 / 凭证）
# 用法：复制为 .env 并填入真实值
# 运行时参数（模型名、URL、开关、阈值等）请写在 .config.yaml
# 加载入口：load_secrets()（yard/configs/secrets.py）
# =============================================================================

# ==================== LLM ====================

# 主 LLM 的 OpenAI 兼容 API Key（必填）
# 用于：主对话模型、未单独配置时的情绪评估与 Mem0 抽取
GLM_OPENAI_API_KEY=

# 情绪 VAD 前置判定模型的 API Key（通常比主模型更小、更便宜）
# 何时必填：可选；emotion_appraisal_enabled: true 且希望与主模型分配额时
# 不填时：自动复用 GLM_OPENAI_API_KEY
# 对应 YAML：emotion_appraisal_model、emotion_appraisal_base_url
EMOTION_APPRAISAL_API_KEY=

# Mem0 记忆抽取 / infer 所用 LLM 的 API Key
# 何时必填：可选；memory_enabled: true 且希望冷路径异步抽取与主对话分配额时
# 不填时：自动复用 GLM_OPENAI_API_KEY
MEM0_LLM_API_KEY=

# DeepEval 情绪支持评测（前端 Test 面板）所用 LLM 的 API Key
# 何时必填：使用 /api/eval/emotion-support/run 时
# 不填时：自动复用 GLM_OPENAI_API_KEY
# 对应 YAML：eval_llm_model、eval_llm_base_url
EVAL_LLM_API_KEY=

# ==================== ASR（语音转文字）====================
# 仅当 input_modality 含 audio 时需要；纯文本对话可留空

# 火山引擎（豆包）流式 ASR 应用 ID
# 对应 YAML：audio.asr_provider_name: "DoubaoStreamingASR"（默认）
DOUBAO_STREAMING_ASR_APPID=

# 火山引擎（豆包）流式 ASR 访问令牌
DOUBAO_STREAMING_ASR_ACCESS_TOKEN=

# 阿里云智能语音 NLS — 长期 AccessKey（推荐生产环境）
# 对应 YAML：audio.asr_provider_name: "AliyunStreamingASR"
# 与下方短期 token 二选一即可
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=

# 阿里云 NLS — 短期 AppKey + Token（开发/调试常用）
# ASR 与 TTS 共用同一组（代码中 TTS 也读这两项）
ALIYUN_APPKEY=
ALIYUN_TOKEN=

# ==================== TTS（文字转语音）====================
# 仅当 output_modality 含 audio 时需要；纯文本对话可留空

# 火山引擎 TTS 应用 ID（可与豆包 ASR 相同）
# 对应 YAML：tts.tts_provider_name: "HuoshanTTS"（默认）
HUOSHAN_APPID=

# 火山引擎 TTS 访问令牌
HUOSHAN_ACCESS_TOKEN=

# ==================== Langfuse 观测（可选）====================
# 两项都填才启用 LLM 调用链追踪；任一项为空则完全跳过
# 无需在 .config.yaml 配置；默认连接本地 http://localhost:3000
# 高级覆盖（一般不用改）：LANGFUSE_BASE_URL、LANGFUSE_TIMEOUT、
# LANGFUSE_PROBE_TIMEOUT_SEC、LANGFUSE_PROBE_REACHABILITY
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ==================== 运行时覆盖（可选，一般不用改）====================

# Mem0 操作历史 SQLite 路径（覆盖 Mem0 默认 ~/.mem0/history.db）
# MEM0_HISTORY_DB_PATH=~/.mem0/history.db

# 日志目录覆盖（默认：项目根目录 logs/）
# GARDEN_LOG_DIR=

# 跨进程共享状态后端类型（默认 lmdb；亦支持 redis 等，视实现而定）
# SHARED_STATE_BACKEND=lmdb
